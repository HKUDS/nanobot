{
  "setup": {
    "docsLabel": "Abrir guia do Matrix",
    "officialLabel": "Abrir lista de clientes Matrix",
    "fields": {
      "homeserver": {
        "label": "Homeserver",
        "placeholder": "https://matrix.org"
      },
      "userId": {
        "label": "ID de usuário",
        "placeholder": "@nanobot:matrix.org"
      },
      "password": {
        "label": "Senha",
        "placeholder": "••••••"
      },
      "accessToken": {
        "label": "Token de acesso",
        "placeholder": "Informe um token de acesso"
      },
      "deviceId": {
        "label": "ID do dispositivo",
        "placeholder": "Obrigatório com token"
      },
      "groupPolicy": {
        "label": "Regras de grupo",
        "choices": {
          "mention": "Somente menções",
          "open": "Todas as mensagens",
          "allowlist": "Lista de permissão",
          "listen": "Ouvir (responder ao mencionar)"
        }
      },
      "groupPolicyOverrides": {
        "label": "Exceções de regras por sala (JSON)"
      },
      "allowFrom": {
        "label": "Usuários permitidos"
      },
      "e2eeEnabled": {
        "label": "Criptografia ponta a ponta",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "sasVerification": {
        "label": "Verificação SAS",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "syncStopGraceSeconds": {
        "label": "Espera de parada sync (segundos)"
      },
      "maxMediaBytes": {
        "label": "Limite de mídia (bytes)"
      },
      "maxConcurrentMediaDownloads": {
        "label": "Downloads simultâneos"
      },
      "groupAllowFrom": {
        "label": "Grupos permitidos"
      },
      "allowRoomMentions": {
        "label": "Menções de sala",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "replyToMessage": {
        "label": "Citar ao responder",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "streaming": {
        "label": "Transmissão",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "useProxy": {
        "label": "Usar proxy"
      }
    }
