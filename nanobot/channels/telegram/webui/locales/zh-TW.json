{
  "setup": {
    "docsLabel": "開啟 Telegram 設定指南",
    "officialLabel": "開啟 BotFather",
    "fields": {
      "token": {
        "label": "機器人權杖",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "網路代理",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "允許的使用者",
        "placeholder": "* 或 Telegram 使用者 ID"
      },
      "technical_profileName": {"label": "通知設定名稱", "help": "額外的僅傳送通知設定。"},
      "technical_mainChatId": {"label": "擁有者使用者 ID", "help": "個人數字 ID；允許清單只能包含此 ID。"},
      "technical_sharedInbox": {"label": "Telegram / WebUI 共用聊天", "help": "重新啟動後啟用；無需啟用技術通知。"},
      "technical_enabled": {"label": "技術通知", "help": "選用：僅名稱和狀態，不包含參數、結果或原始日誌。"},
      "technical_chatId": {"label": "技術通知聊天 ID", "placeholder": "-1001234567890", "help": "專用群組或頻道；忽略收到的訊息。"},
      "technical_token": {"label": "技術通知機器人權杖（選用）", "help": "留空則使用主要機器人。技術通知私聊需要獨立的機器人。"},
      "technical_includeToolEvents": {"label": "包含工具名稱和執行狀態"},
      "technical_includeStatusEvents": {"label": "包含執行、重試和上下文狀態"},
      "groupPolicy": {
        "label": "群組行為",
        "choices": {
          "mention": "僅提及時",
          "open": "所有訊息",
          "allowlist": "允許清單"
        }
      },
      "mode": {
        "label": "連接方式",
        "choices": {
          "polling": "長輪詢",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "引用回覆",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "reactEmoji": {
        "label": "已讀表情"
      },
      "connectionPoolSize": {
        "label": "連線池大小"
      },
      "poolTimeout": {
        "label": "連接池逾時"
      },
      "streaming": {
        "label": "串流輸出",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "inlineKeyboards": {
        "label": "內聯鍵盤",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "richMessages": {
        "label": "富文本訊息",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "streamEditInterval": {
        "label": "串流更新間隔"
      },
      "webhookUrl": {
        "label": "Webhook 地址"
      },
      "webhookListenHost": {
        "label": "Webhook 監聽地址"
      },
      "webhookListenPort": {
        "label": "Webhook 監聽端口"
      },
      "webhookPath": {
        "label": "Webhook 路徑"
      },
      "webhookSecretToken": {
        "label": "Webhook 密鑰"
      },
      "webhookMaxConnections": {
        "label": "Webhook 最大連線數"
      }
    }
  }
}
