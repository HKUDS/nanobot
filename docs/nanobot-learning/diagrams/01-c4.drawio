          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="60"/><mxPoint x="950" y="60"/><mxPoint x="950" y="60"/><mxPoint x="950" y="60"/><mxPoint x="950" y="170"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="compact / consolidate" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="session" target="memory">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="310"/><mxPoint x="950" y="360"/></Array></mxGeometry>
