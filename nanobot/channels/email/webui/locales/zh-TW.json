        "label": "附件型別"
      },
      "maxAttachmentSize": {
        "label": "單件上限（位元組）"
      },
      "maxAttachmentsPerEmail": {
        "label": "數量上限"
      },
      "trustedAuthservIds": {
        "label": "可信郵件驗證服務",
        "placeholder": "mx.google.com，以逗號分隔"
      }
    }
