      },
      "imapUsername": {
        "label": "IMAP 使用者名稱",
        "placeholder": "bot@example.com"
      },
      "imapPassword": {
        "label": "IMAP 密碼",
        "placeholder": "應用程式密碼"
      },
      "smtpHost": {
        "label": "SMTP 主機",
