{
  "setup": {
    "docsLabel": "הגדרות החיבור ל־Telegram",
    "officialLabel": "פתיחת BotFather",
    "fields": {
      "token": {
        "label": "אסימון גישה של הבוט",
        "placeholder": "123456:ABC..."
      },
      "useProxy": {
        "label": "שימוש בשרת פרוקסי"
      },
      "allowFrom": {
        "label": "משתמשים מורשים",
        "placeholder": "* או מזהי משתמשים ב־Telegram"
      },
      "groupPolicy": {
        "label": "כללי הקבוצה",
        "choices": {
          "mention": "אזכורים בלבד",
          "open": "כל ההודעות",
          "allowlist": "רשימת מורשים"
        }
      },
      "mode": {
        "label": "מצב חיבור",
        "choices": {
          "polling": "תשאול ממושך (Long polling)",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "מענה להודעה",
        "choices": {
          "true": "פעיל",
          "false": "כבוי"
        }
      },
      "reactEmoji": {
        "label": "אימוג׳י לסימון הודעה כנקראה"
      },
      "connectionPoolSize": {
        "label": "גודל מאגר החיבורים"
      },
      "poolTimeout": {
        "label": "זמן ההמתנה במאגר החיבורים"
      },
      "streaming": {
        "label": "הזרמה",
        "choices": {
          "true": "פעיל",
          "false": "כבוי"
        }
      },
      "inlineKeyboards": {
        "label": "כפתורי הודעה",
        "choices": {
          "true": "פעיל",
          "false": "כבוי"
        }
      },
      "richMessages": {
        "label": "הודעות עשירות",
        "choices": {
          "true": "פעיל",
          "false": "כבוי"
        }
      },
      "streamEditInterval": {
        "label": "מרווח עדכון (שניות)"
      },
      "webhookUrl": {
        "label": "כתובת Webhook"
      },
      "webhookListenHost": {
        "label": "כתובת האזנה של ה־Webhook"
      },
      "webhookListenPort": {
        "label": "יציאת האזנה של ה־Webhook"
      },
      "webhookPath": {
        "label": "נתיב Webhook"
      },
      "webhookSecretToken": {
        "label": "אסימון סודי של ה־Webhook"
      },
      "webhookMaxConnections": {
        "label": "מגבלת החיבורים של ה־Webhook"
      }
    }
  }
}
