{
  "setup": {
    "docsLabel": "Ouvrir le guide Slack",
    "officialLabel": "Ouvrir les applications Slack",
    "actions": {
      "slack-manifest": "Copier le manifeste de l’application"
    },
    "fields": {
      "appToken": {
        "label": "Jeton d’application",
        "placeholder": "xapp-..."
      },
      "botToken": {
        "label": "Jeton du bot",
        "placeholder": "xoxb-..."
      },
      "groupPolicy": {
        "label": "Comportement en groupe",
        "choices": {
          "mention": "Mentions uniquement",
          "open": "Tous les messages",
          "allowlist": "Liste d’autorisation"
        }
      },
      "mode": {
        "label": "Mode de connexion",
        "choices": {
          "socket": "Mode prise"
        }
      },
      "webhookPath": {
        "label": "Chemin du webhook"
      },
      "replyInThread": {
        "label": "Répondre dans le fil de discussion",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "reactEmoji": {
        "label": "Lire les emoji"
      },
      "doneEmoji": {
        "label": "Terminé emoji"
      },
      "includeThreadContext": {
        "label": "Inclure le contexte du fil de discussion",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "threadContextLimit": {
        "label": "Limite du contexte du fil de discussion"
      },
      "allowFrom": {
        "label": "Utilisateurs autorisés"
      },
      "groupAllowFrom": {
        "label": "Chaînes autorisées"
      },
      "groupRequireMention": {
        "label": "Exiger des mentions dans les chaînes",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "dm_enabled": {
        "label": "Activer les messages directs",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "dm_policy": {
        "label": "Accès aux messages directs",
        "choices": {
          "allowlist": "Liste verte",
          "open": "Ouvert"
        }
      },
      "dm_allowFrom": {
        "label": "Utilisateurs de messagerie directe autorisés"
      },
      "proxy": {
        "label": "Proxy réseau",
        "placeholder": "http://127.0.0.1:7890"
      }
    }
  }
}
