  <diagram id="agent-components" name="Agent Components">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bus" value="MessageBus&#xa;[Component: asyncio.Queue]&#xa;解耦生产者和消费者" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="0" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="loop" value="AgentLoop&#xa;[Component: agent/loop.py]&#xa;消费 inbound，管理 session key 与生命周期" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="410" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="context" value="ContextBuilder&#xa;[Component: agent/context.py]&#xa;拼装 system prompt、历史、工具说明和 bootstrap 文件" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="280" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="runner" value="AgentRunner&#xa;[Component: agent/runner.py]&#xa;执行模型响应、tool call、结果回填和终止条件" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="550" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="registry" value="ToolRegistry&#xa;[Component: agent/tools/registry.py]&#xa;暴露工具定义和 JSON schema" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="session" value="SessionManager&#xa;[Component: session/manager.py]&#xa;历史读取、压缩、TTL 与目标状态" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="830" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="memory" value="MemoryStore&#xa;[Component: agent/memory.py]&#xa;长期记忆与 Dream 两阶段 consolidation" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="830" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="providerfactory" value="ProviderFactory&#xa;[Component: providers/factory.py]&#xa;根据 model/provider 配置选择实现" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="550" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="openaiadapter" value="OpenAICompatProvider&#xa;[Component: providers/openai_compat_provider.py]&#xa;兼容 OpenAI Chat Completions 与自定义 base URL" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="550" y="560" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="consume inbound / publish outbound" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="loop" target="bus">
