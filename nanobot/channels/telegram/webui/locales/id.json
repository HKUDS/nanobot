{
  "setup": {
    "docsLabel": "Buka panduan Telegram",
    "officialLabel": "Buka BotFather",
    "fields": {
      "token": {
        "label": "Token bot",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "Proxy jaringan",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "Pengguna yang diizinkan",
        "placeholder": "* atau ID pengguna Telegram"
      },
      "technical_profileName": {"label": "Profil notifikasi", "help": "Profil tambahan khusus pesan keluar."},
      "technical_mainChatId": {"label": "ID pemilik", "help": "ID pengguna pribadi; daftar izin hanya boleh berisi ID ini."},
      "technical_sharedInbox": {"label": "Obrolan bersama Telegram / WebUI", "help": "Aktif setelah mulai ulang; tidak memerlukan profil teknis."},
      "technical_enabled": {"label": "Notifikasi teknis", "help": "Opsional: hanya nama dan status, tanpa argumen, hasil, atau log mentah."},
      "technical_chatId": {"label": "ID obrolan teknis", "placeholder": "-1001234567890", "help": "Grup atau kanal khusus; pesan masuk diabaikan."},
      "technical_token": {"label": "Token bot teknis (opsional)", "help": "Kosong memakai bot utama. Pesan pribadi teknis memerlukan bot terpisah."},
      "technical_includeToolEvents": {"label": "Sertakan nama dan status alat"},
      "technical_includeStatusEvents": {"label": "Sertakan status proses dan percobaan ulang"},
      "groupPolicy": {
        "label": "Perilaku grup",
        "choices": {
          "mention": "Hanya saat disebut",
          "open": "Semua pesan",
          "allowlist": "Daftar izin"
        }
      },
      "mode": {
        "label": "Modus koneksi",
        "choices": {
          "polling": "Jajak pendapat yang panjang",
          "webhook": "kait web"
        }
      },
      "replyToMessage": {
        "label": "Membalas pesan",
        "choices": {
          "true": "Aktif",
          "false": "Mati"
        }
      },
      "reactEmoji": {
        "label": "Baca emoji"
      },
      "connectionPoolSize": {
        "label": "Ukuran kumpulan koneksi"
      },
      "poolTimeout": {
        "label": "Batas waktu kumpulan koneksi habis"
      },
      "streaming": {
        "label": "Streaming",
        "choices": {
          "true": "Aktif",
          "false": "Mati"
        }
      },
      "inlineKeyboards": {
        "label": "Keyboard sebaris",
        "choices": {
          "true": "Aktif",
          "false": "Mati"
        }
      },
      "richMessages": {
        "label": "Pesan yang kaya",
        "choices": {
          "true": "Aktif",
          "false": "Mati"
        }
      },
      "streamEditInterval": {
        "label": "Interval pembaruan aliran"
      },
      "webhookUrl": {
        "label": "URL kait web"
      },
      "webhookListenHost": {
        "label": "Tuan rumah mendengarkan webhook"
      },
      "webhookListenPort": {
        "label": "Port mendengarkan webhook"
      },
      "webhookPath": {
        "label": "Jalur webhook"
      },
      "webhookSecretToken": {
        "label": "Token rahasia webhook"
      },
      "webhookMaxConnections": {
        "label": "Koneksi webhook maksimum"
      }
    }
  }
}
