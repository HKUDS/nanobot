{
  "setup": {
    "docsLabel": "打开 Telegram 配置指南",
    "officialLabel": "打开 BotFather",
    "fields": {
      "token": {
        "label": "机器人令牌",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "网络代理",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "允许的用户",
        "placeholder": "* 或 Telegram 用户 ID"
      },
      "technical_profileName": {"label": "通知配置名称", "help": "额外的仅发送通知配置。"},
      "technical_mainChatId": {"label": "所有者用户 ID", "help": "个人数字 ID；允许列表只能包含此 ID。"},
      "technical_sharedInbox": {"label": "Telegram / WebUI 共享聊天", "help": "重启后启用；无需启用技术通知。"},
      "technical_enabled": {"label": "技术通知", "help": "可选：仅名称和状态，不包含参数、结果或原始日志。"},
      "technical_chatId": {"label": "技术通知聊天 ID", "placeholder": "-1001234567890", "help": "专用群组或频道；忽略收到的消息。"},
      "technical_token": {"label": "技术通知机器人令牌（可选）", "help": "留空则使用主机器人。技术通知私聊需要单独的机器人。"},
      "technical_includeToolEvents": {"label": "包含工具名称和运行状态"},
      "technical_includeStatusEvents": {"label": "包含运行、重试和上下文状态"},
      "groupPolicy": {
        "label": "群组行为",
        "choices": {
          "mention": "仅提及时",
          "open": "所有消息",
          "allowlist": "白名单"
        }
      },
      "mode": {
        "label": "连接方式",
        "choices": {
          "polling": "长轮询",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "引用回复",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "reactEmoji": {
        "label": "已读表情"
      },
      "connectionPoolSize": {
        "label": "连接池大小"
      },
      "poolTimeout": {
        "label": "连接池超时"
      },
      "streaming": {
        "label": "流式输出",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "inlineKeyboards": {
        "label": "内联键盘",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "richMessages": {
        "label": "富文本消息",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "streamEditInterval": {
        "label": "流式更新间隔"
      },
      "webhookUrl": {
        "label": "Webhook 地址"
      },
      "webhookListenHost": {
        "label": "Webhook 监听地址"
      },
      "webhookListenPort": {
        "label": "Webhook 监听端口"
      },
      "webhookPath": {
        "label": "Webhook 路径"
      },
      "webhookSecretToken": {
        "label": "Webhook 密钥"
      },
      "webhookMaxConnections": {
        "label": "Webhook 最大连接数"
      }
    }
  }
}
