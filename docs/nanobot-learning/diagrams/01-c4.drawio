        </mxCell>
        <mxCell id="e1" value="build messages" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="loop" target="context">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="120"/><mxPoint x="460" y="170"/></Array></mxGeometry>
