      "allowFrom": {
        "label": "Expéditeurs autorisés",
        "placeholder": "user:1234567890"
      },
      "stateDir": {
        "label": "Répertoire d'état",
        "placeholder": "~/.nanobot/whatsapp-agent"
      },
      "pollTimeout": {
        "label": "Délai d'interrogation (secondes)",
        "placeholder": "25"
      },
      "maxMediaMb": {
        "label": "Taille max. des médias (Mo)",
        "placeholder": "16"
      },
      "markRead": {
        "label": "Envoyer les accusés de lecture",
        "choices": {
          "true": "Activé",
