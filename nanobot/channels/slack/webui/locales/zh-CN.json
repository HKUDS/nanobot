{
  "setup": {
    "docsLabel": "打开 Slack 配置指南",
    "officialLabel": "打开 Slack 应用后台",
    "actions": {
      "slack-manifest": "复制应用清单"
    },
    "fields": {
      "appToken": {
        "label": "应用令牌",
        "placeholder": "xapp-..."
      },
      "botToken": {
        "label": "机器人令牌",
        "placeholder": "xoxb-..."
      },
      "groupPolicy": {
        "label": "群聊规则",
        "choices": {
          "mention": "提及回复",
          "open": "全部消息",
          "allowlist": "白名单"
        }
      },
      "mode": {
        "label": "连接方式",
        "choices": {
          "socket": "Socket 模式"
        }
      },
      "webhookPath": {
        "label": "Webhook 路径"
      },
      "replyInThread": {
        "label": "话题回复",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "reactEmoji": {
        "label": "已读表情"
      },
      "doneEmoji": {
        "label": "完成表情"
      },
      "includeThreadContext": {
        "label": "话题上下文",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "threadContextLimit": {
        "label": "上下文上限"
      },
      "allowFrom": {
        "label": "允许用户"
      },
      "groupAllowFrom": {
        "label": "允许频道"
      },
      "groupRequireMention": {
        "label": "提及回复",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "dm_enabled": {
        "label": "启用私聊",
        "choices": {
          "true": "开启",
          "false": "关闭"
        }
      },
      "dm_policy": {
        "label": "私聊权限",
        "choices": {
          "allowlist": "白名单",
          "open": "全部"
        }
      },
      "dm_allowFrom": {
        "label": "私聊用户"
      },
      "proxy": {
        "label": "网络代理",
        "placeholder": "http://127.0.0.1:7890"
      }
    }
  }
}
