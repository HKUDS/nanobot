{
  "setup": {
    "docsLabel": "Abrir guía de Slack",
    "officialLabel": "Abrir aplicaciones de Slack",
    "actions": {
      "slack-manifest": "Copiar manifiesto de la aplicación"
    },
    "fields": {
      "appToken": {
        "label": "Token de la app",
        "placeholder": "xapp-..."
      },
      "botToken": {
        "label": "Token del bot",
        "placeholder": "xoxb-..."
      },
      "groupPolicy": {
        "label": "Comportamiento en grupos",
        "choices": {
          "mention": "Solo menciones",
          "open": "Todos los mensajes",
          "allowlist": "Lista de permitidos"
        }
      },
      "mode": {
        "label": "Modo de conexión",
        "choices": {
          "socket": "Modo de enchufe"
        }
      },
      "webhookPath": {
        "label": "Ruta del webhook"
      },
      "replyInThread": {
        "label": "Responder en el hilo",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "reactEmoji": {
        "label": "Leer emojis"
      },
      "doneEmoji": {
        "label": "emoji hecho"
      },
      "includeThreadContext": {
        "label": "Incluir contexto de hilo",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "threadContextLimit": {
        "label": "Límite de contexto del hilo"
      },
      "allowFrom": {
        "label": "Usuarios permitidos"
      },
      "groupAllowFrom": {
        "label": "Canales permitidos"
      },
      "groupRequireMention": {
        "label": "Requerir menciones en canales",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "dm_enabled": {
        "label": "Habilitar mensajes directos",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "dm_policy": {
        "label": "Acceso a mensajes directos",
        "choices": {
          "allowlist": "Lista de permitidos",
          "open": "Abierto"
        }
      },
      "dm_allowFrom": {
        "label": "Usuarios permitidos de mensajes directos"
      },
      "proxy": {
        "label": "Proxy de red",
        "placeholder": "http://127.0.0.1:7890"
      }
    }
  }
}
