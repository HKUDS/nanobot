{
  "setup": {
    "docsLabel": "Slack 設定ガイドを開く",
    "officialLabel": "Slack アプリを開く",
    "actions": {
      "slack-manifest": "アプリマニフェストをコピー"
    },
    "fields": {
      "appToken": {
        "label": "アプリトークン",
        "placeholder": "xapp-..."
      },
      "botToken": {
        "label": "ボットトークン",
        "placeholder": "xoxb-..."
      },
      "groupPolicy": {
        "label": "グループのルール",
        "choices": {
          "mention": "メンションのみ",
          "open": "全メッセージ",
          "allowlist": "許可リスト"
        }
      },
      "mode": {
        "label": "接続モード",
        "choices": {
          "socket": "ソケットモード"
        }
      },
      "webhookPath": {
        "label": "Webhook パス"
      },
      "replyInThread": {
        "label": "スレッドで返信",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "reactEmoji": {
        "label": "絵文字を読む"
      },
      "doneEmoji": {
        "label": "完了絵文字"
      },
      "includeThreadContext": {
        "label": "スレッドの文脈",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "threadContextLimit": {
        "label": "コンテキストの上限"
      },
      "allowFrom": {
        "label": "許可ユーザー"
      },
      "groupAllowFrom": {
        "label": "許可チャンネル"
      },
      "groupRequireMention": {
        "label": "チャンネルのメンション必須",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "dm_enabled": {
        "label": "ダイレクトメッセージを有効にする",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "dm_policy": {
        "label": "ダイレクトメッセージへのアクセス",
        "choices": {
          "allowlist": "ホワイトリスト",
          "open": "開く"
        }
      },
      "dm_allowFrom": {
        "label": "許可する DM ユーザー"
      },
      "proxy": {
        "label": "ネットワークプロキシ",
        "placeholder": "http://127.0.0.1:7890"
      }
    }
  }
}
