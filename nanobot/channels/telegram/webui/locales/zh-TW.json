{
  "setup": {
    "docsLabel": "開啟 Telegram 設定指南",
    "officialLabel": "開啟 BotFather",
    "fields": {
      "token": {
        "label": "機器人權杖",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "網路代理",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "允許使用者",
        "placeholder": "* 或 Telegram 使用者 ID"
      },
      "groupPolicy": {
        "label": "群聊規則",
        "choices": {
          "mention": "提及回覆",
          "open": "全部訊息",
          "allowlist": "允許清單"
        }
      },
      "groupPolicyOverrides": {
        "label": "群组行为覆盖（JSON）"
      },
      "mode": {
        "label": "連接方式",
        "choices": {
          "polling": "長輪詢",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "引用回覆",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "reactEmoji": {
        "label": "已讀表情"
      },
      "connectionPoolSize": {
        "label": "連線池大小"
      },
      "poolTimeout": {
        "label": "連接池逾時"
      },
      "streaming": {
        "label": "串流輸出",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "inlineKeyboards": {
        "label": "訊息按鈕",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "richMessages": {
        "label": "富文本訊息",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "streamEditInterval": {
        "label": "更新間隔（秒）"
      },
      "webhookUrl": {
        "label": "Webhook 地址"
      },
      "webhookListenHost": {
        "label": "Webhook 監聽地址"
      },
      "webhookListenPort": {
        "label": "Webhook 監聽端口"
      },
      "webhookPath": {
        "label": "Webhook 路徑"
      },
      "webhookSecretToken": {
        "label": "Webhook 密鑰"
      },
      "webhookMaxConnections": {
        "label": "Webhook 連線上限"
      }
    }
  }
}
