{
  "setup": {
    "docsLabel": "Ouvrir le guide Mattermost",
    "officialLabel": "Ouvrir le guide des bots Mattermost",
    "fields": {
      "serverUrl": {
        "label": "URL du serveur",
        "placeholder": "https://mattermost.example.com"
      },
      "token": {
        "label": "Jeton du bot",
        "placeholder": "Jeton du bot Mattermost"
      },
      "teamId": {
        "label": "ID de l’équipe",
        "placeholder": "ID d’équipe facultatif"
      },
      "groupPolicy": {
        "label": "Règles du canal",
        "choices": {
          "mention": "Mentions uniquement",
          "open": "Tous les messages",
          "allowlist": "Liste d'autorisation"
        }
      },
      "groupPolicyInThread": {
        "label": "Règles du fil",
        "choices": {
          "mention": "Mentions uniquement",
          "open": "Tous les messages (sans mention)",
          "allowlist": "Liste d'autorisation"
        }
      },
      "allowFrom": {
        "label": "Utilisateurs autorisés",
        "placeholder": "ID utilisateur séparés par des virgules"
      },
      "allowFromMatchMode": {
        "label": "Correspondance utilisateur",
        "choices": {
          "email": "Courriel",
          "id": "Identifiant utilisateur",
          "username": "Nom d'utilisateur"
        }
      },
      "groupAllowFrom": {
        "label": "Canaux autorisés"
      },
      "replyInThread": {
        "label": "Réponses dans le fil",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "includeThreadContext": {
        "label": "Contexte du fil",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "threadContextLimit": {
        "label": "Limite du contexte"
      },
      "streaming": {
        "label": "Diffusion en continu",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "reactEmoji": {
        "label": "Lire les emoji"
      },
      "doneEmoji": {
        "label": "Terminé emoji"
      },
      "sendProgress": {
        "label": "Envoyer l’avancement",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "sendToolHints": {
        "label": "Indications des outils",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "dm_enabled": {
        "label": "Activer les messages directs",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "dm_policy": {
        "label": "Accès aux messages directs",
        "choices": {
          "allowlist": "Liste verte",
          "open": "Ouvert"
        }
      },
      "dm_allowFrom": {
        "label": "Utilisateurs de DM autorisés"
      }
    }
  }
}
