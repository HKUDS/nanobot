      },
      "imapMailbox": {
        "label": "IMAP 信箱"
      },
      "imapUseSsl": {
        "label": "IMAP SSL",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "smtpUseTls": {
        "label": "SMTP TLS",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "smtpUseSsl": {
        "label": "SMTP SSL",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "autoReplyEnabled": {
        "label": "自動回覆",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "markSeen": {
        "label": "標為已讀",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
