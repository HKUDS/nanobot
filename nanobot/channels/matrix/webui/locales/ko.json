      "groupAllowFrom": {
        "label": "허용된 그룹"
      },
      "allowRoomMentions": {
        "label": "회의실 언급 허용",
        "choices": {
          "true": "켜기",
          "false": "끄기"
        }
      },
      "streaming": {
        "label": "스트리밍",
        "choices": {
          "true": "켜기",
          "false": "끄기"
        }
      },
      "proxy": {
        "label": "네트워크 프록시",
        "placeholder": "http://127.0.0.1:7890"
      }
