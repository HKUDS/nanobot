<mxfile>
  <diagram id="system-context" name="System Context">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="user" value="使用者&#xa;[Person]&#xa;通过 WebUI 或聊天平台与 nanobot 对话" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="200" height="180" as="geometry"/>
        </mxCell>
        <UserObject label="nanobot AI Agent&#xa;[Software System: Python / asyncio]&#xa;接收消息、调用模型与工具、维护会话记忆" link="data:page/id,containers" id="nanobot">
          <mxCell style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#1061B0;strokeColor=#0D5091;" vertex="1" parent="1">
          <mxGeometry x="240" y="250" width="240" height="120" as="geometry"/>
        </mxCell>
        </UserObject>
        <mxCell id="llm" value="LLM Provider&#xa;[Software System: OpenAI-compatible / Anthropic / Bedrock]&#xa;生成文本、工具调用与流式事件" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="chat" value="聊天平台&#xa;[Software System: Telegram / Discord / Slack / ...]&#xa;外部消息与通知渠道" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="240" y="30" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="webbrowser" value="Web Browser&#xa;[Software System: React / Vite]&#xa;运行 nanobot WebUI" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="510" y="30" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="toolsystem" value="外部工具与服务&#xa;[Software System: HTTP / MCP / Shell]&#xa;搜索、网页、文件系统和可选 MCP 服务" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="370" y="430" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="发送消息 / 查看响应" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="user" target="nanobot">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="240"/><mxPoint x="150" y="310"/><mxPoint x="150" y="310"/><mxPoint x="150" y="310"/><mxPoint x="220" y="310"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e1" value="WebSocket / HTTP" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="webbrowser" target="nanobot">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="210"/><mxPoint x="560" y="310"/><mxPoint x="560" y="310"/><mxPoint x="560" y="310"/><mxPoint x="490" y="310"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Channel 事件" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="chat" target="nanobot">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="150"/><mxPoint x="360" y="230"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Chat Completions / Responses" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="nanobot" target="llm">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="370"/><mxPoint x="290" y="420"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="执行工具并接收结果" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="nanobot" target="toolsystem">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="370"/><mxPoint x="430" y="420"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="containers" name="Containers">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cli" value="CLI Runtime&#xa;[Container: Typer / uv run]&#xa;解析命令、加载配置、启动 gateway 或 webui" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="280" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="gateway" value="Gateway Runtime&#xa;[Container: asyncio task supervisor]&#xa;并行运行消息总线、AgentLoop、Channel 与 API" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="280" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <UserObject label="Agent Core&#xa;[Container: AgentLoop + AgentRunner]&#xa;构造上下文，驱动模型-工具循环，发布出站消息" link="data:page/id,agent-components" id="agentcore">
          <mxCell style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="240" height="120" as="geometry"/>
        </mxCell>
        </UserObject>
        <mxCell id="providers" value="Provider Layer&#xa;[Container: ProviderFactory / Registry]&#xa;统一不同模型供应商、流式响应和重试" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="0" y="740" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="channels" value="Channel Layer&#xa;[Container: pkgutil discovery]&#xa;WebSocket 与聊天平台适配器，统一 Inbound/OutboundMessage" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="apiserver" value="OpenAI-compatible API&#xa;[Container: FastAPI]&#xa;提供 /v1/chat/completions 与 /v1/models" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="550" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="state" value="Session &amp; Memory&#xa;[Container: JSONL + atomic writes]&#xa;持久化历史、长期记忆、压缩与目标状态" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="280" y="740" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="tooling" value="Tool Runtime&#xa;[Container: ToolRegistry / security guards]&#xa;发现工具、生成 schema、执行权限与网络边界检查" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
          <mxGeometry x="550" y="740" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e0" value="启动并注入 Config" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="cli" target="gateway">
