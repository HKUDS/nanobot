    "fields": {
      "appId": {
        "label": "App ID",
        "placeholder": "Microsoft App ID"
      },
      "appPassword": {
        "label": "Secreto del cliente",
        "placeholder": "••••••"
      },
      "tenantId": {
        "label": "ID del tenant",
        "placeholder": "ID de tenant opcional"
      },
      "path": {
        "label": "Ruta de callback",
        "placeholder": "/api/messages"
      },
      "allowFrom": {
        "label": "Usuarios permitidos",
        "placeholder": "ID de usuario de Teams separados por comas"
      },
      "host": {
        "label": "Escuchar anfitrión"
      },
      "port": {
        "label": "Puerto de escucha"
      },
      "replyInThread": {
        "label": "Respuestas en hilo",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "mentionOnlyResponse": {
        "label": "Respuesta a mención sola"
      },
      "validateInboundAuth": {
        "label": "Verificar solicitudes",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "refTtlDays": {
        "label": "Duración de referencias (días)"
      },
      "pruneWebChatRefs": {
        "label": "Limpiar referencias Web Chat",
        "help": "Eliminar las referencias de envío guardadas de Web Chat y conservar el historial.",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "pruneNonPersonalRefs": {
        "label": "Limpiar referencias de grupos",
        "help": "Eliminar las referencias de envío de chats no personales y conservar el historial.",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "refTouchIntervalS": {
        "label": "Intervalo de actualización (segundos)"
      },
      "trustedServiceUrlHosts": {
        "label": "Hosts de confianza"
      }
    }
