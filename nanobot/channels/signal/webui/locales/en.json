      },
      "daemonHost": {
        "label": "Daemon host",
        "placeholder": "localhost"
      },
      "daemonPort": {
        "label": "Daemon port",
        "placeholder": "8080"
      },
      "dm_allowFrom": {
        "label": "Allowed direct message senders",
        "placeholder": "Phone numbers or UUIDs"
      },
      "group_allowFrom": {
        "label": "Allowed groups",
