        </mxCell>
        <mxCell id="e1" value="启动 Channel tasks" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="gateway" target="channels">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="310"/><mxPoint x="400" y="360"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="启动 AgentLoop" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="gateway" target="agentcore">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="250"/><mxPoint x="260" y="250"/><mxPoint x="260" y="250"/><mxPoint x="260" y="250"/><mxPoint x="260" y="600"/><mxPoint x="260" y="600"/><mxPoint x="260" y="600"/><mxPoint x="260" y="600"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="挂载 API" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="gateway" target="apiserver">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="250"/><mxPoint x="670" y="250"/><mxPoint x="670" y="250"/><mxPoint x="670" y="250"/><mxPoint x="670" y="360"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="Inbound / Outbound events" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="channels" target="agentcore">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="490"/><mxPoint x="400" y="540"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="模型请求与流式事件" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="agentcore" target="providers">
