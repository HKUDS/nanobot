        </mxCell>
        <mxCell id="e6" value="工具 schema / execute" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="agentcore" target="tooling">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="640"/><mxPoint x="710" y="640"/><mxPoint x="710" y="640"/><mxPoint x="710" y="640"/><mxPoint x="710" y="730"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="读取上下文 / 写入历史" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="agentcore" target="state">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="680"/><mxPoint x="400" y="730"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="复用 Agent service" style="endArrow=blockThin;endFill=1;endSize=10;html=1;fontSize=11;fontColor=#404040;strokeColor=#828282;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="apiserver" target="agentcore">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="540"/><mxPoint x="630" y="600"/><mxPoint x="630" y="600"/><mxPoint x="630" y="600"/><mxPoint x="530" y="600"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
