{
  "setup": {
    "docsLabel": "Ouvrir le guide Telegram",
    "officialLabel": "Ouvrir BotFather",
    "fields": {
      "token": {
        "label": "Jeton du bot",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "Proxy réseau",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "Utilisateurs autorisés",
        "placeholder": "* ou ID utilisateur Telegram"
      },
      "technical_profileName": {"label": "Profil de notifications", "help": "Profil supplémentaire en sortie uniquement."},
      "technical_mainChatId": {"label": "ID du propriétaire", "help": "ID privé ; la liste autorisée doit contenir uniquement cet ID."},
      "technical_sharedInbox": {"label": "Discussions partagées Telegram / WebUI", "help": "Active les deux discussions au redémarrage, sans profil technique obligatoire."},
      "technical_enabled": {"label": "Notifications techniques", "help": "Optionnel : noms et états, sans arguments, résultats ni journaux bruts."},
      "technical_chatId": {"label": "ID du groupe technique", "placeholder": "-1001234567890", "help": "Groupe ou canal dédié ; messages entrants ignorés."},
      "technical_token": {"label": "Jeton du bot technique (facultatif)", "help": "Vide : bot principal. Un message privé technique nécessite un autre bot."},
      "technical_includeToolEvents": {"label": "Inclure les noms et états des outils"},
      "technical_includeStatusEvents": {"label": "Inclure les états et nouvelles tentatives"},
      "groupPolicy": {
        "label": "Comportement en groupe",
        "choices": {
          "mention": "Mentions uniquement",
          "open": "Tous les messages",
          "allowlist": "Liste d’autorisation"
        }
      },
      "mode": {
        "label": "Mode de connexion",
        "choices": {
          "polling": "Sondage long",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "Répondre au message",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "reactEmoji": {
        "label": "Lire les emoji"
      },
      "connectionPoolSize": {
        "label": "Taille du pool de connexions"
      },
      "poolTimeout": {
        "label": "Expiration du délai du pool de connexions"
      },
      "streaming": {
        "label": "Diffusion en continu",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "inlineKeyboards": {
        "label": "Claviers en ligne",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "richMessages": {
        "label": "Messages riches",
        "choices": {
          "true": "Sur",
          "false": "Désactivé"
        }
      },
      "streamEditInterval": {
        "label": "Intervalle de mise à jour du flux"
      },
      "webhookUrl": {
        "label": "URL du webhook"
      },
      "webhookListenHost": {
        "label": "Hôte d'écoute du webhook"
      },
      "webhookListenPort": {
        "label": "Port d'écoute du webhook"
      },
      "webhookPath": {
        "label": "Chemin du webhook"
      },
      "webhookSecretToken": {
        "label": "Jeton secret Webhook"
      },
      "webhookMaxConnections": {
        "label": "Nombre maximal de connexions webhook"
      }
    }
  }
}
