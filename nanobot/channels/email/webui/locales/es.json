{
  "displayName": "Correo electrónico",
  "setup": {
    "docsLabel": "Abrir guía de Email",
    "officialLabel": "Abrir guía de contraseñas de app",
    "presetLabel": "Relleno rápido",
    "sections": {
      "receiving": "Recepción de correo",
      "sending": "Envío de correo"
    },
    "presets": {
      "gmail": "Gmail",
      "outlook": "Outlook",
      "icloud": "iCloud"
    },
    "fields": {
      "consentGranted": {
        "label": "Permitir que nanobot lea y envíe correos",
        "choices": {
          "true": "Concedido",
          "false": "No concedido"
        }
      },
      "imapHost": {
        "label": "Host IMAP",
        "placeholder": "imap.gmail.com"
      },
      "imapUsername": {
        "label": "Usuario IMAP",
        "placeholder": "bot@example.com"
      },
      "imapPassword": {
        "label": "Contraseña IMAP",
        "placeholder": "Contraseña de app"
      },
      "smtpHost": {
        "label": "Host SMTP",
        "placeholder": "smtp.gmail.com"
      },
      "smtpUsername": {
        "label": "Usuario SMTP",
        "placeholder": "bot@example.com"
      },
      "smtpPassword": {
        "label": "Contraseña SMTP",
        "placeholder": "Contraseña de app"
      },
      "imapPort": {
        "label": "Puerto IMAP",
        "placeholder": "993"
      },
      "smtpPort": {
        "label": "Puerto SMTP",
        "placeholder": "587"
      },
      "fromAddress": {
        "label": "Dirección remitente",
        "placeholder": "bot@example.com"
      },
      "oauthTenantId": {
        "label": "ID de inquilino de Microsoft",
        "placeholder": "00000000-0000-0000-0000-000000000000",
        "help": "Solo Office365/Outlook. Alternativa a las contraseñas IMAP/SMTP — déjalo vacío para usar contraseñas. Ejecuta `nanobot channels login email` tras guardar estos tres campos."
      },
      "oauthClientId": {
        "label": "ID de aplicación (cliente) de Microsoft",
        "placeholder": "00000000-0000-0000-0000-000000000000"
      },
      "oauthClientSecret": {
        "label": "Secreto de cliente de Microsoft",
        "placeholder": "Valor del secreto del registro de la app"
      },
      "pollIntervalSeconds": {
        "label": "Intervalo de consulta del correo (segundos)",
        "placeholder": "30"
      },
      "allowFrom": {
        "label": "Remitentes permitidos",
        "placeholder": "Correos separados por comas"
      },
      "verifyDkim": {
        "label": "Verificar DKIM",
        "choices": {
          "true": "Activado",
          "false": "Desactivado"
        }
      },
      "verifySpf": {
        "label": "Verificar SPF",
        "choices": {
          "true": "Activado",
          "false": "Desactivado"
        }
      },
      "imapMailbox": {
        "label": "buzón IMAP"
      },
      "imapUseSsl": {
        "label": "SSL IMAP",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "smtpUseTls": {
        "label": "TLS SMTP",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "smtpUseSsl": {
        "label": "SSL SMTP",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "autoReplyEnabled": {
        "label": "Respuestas automáticas",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "markSeen": {
        "label": "Marcar como leído",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "postAction": {
        "label": "Después del procesamiento",
        "choices": {
          "delete": "Eliminar",
          "move": "Mover"
        }
      },
      "postActionMoveMailbox": {
        "label": "Mover al buzón"
      },
      "postActionExpunge": {
        "label": "Aplicar permanentemente la acción",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "postActionIgnoreSkipped": {
        "label": "Ignorar mensajes omitidos",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "maxBodyChars": {
        "label": "Longitud máxima del cuerpo"
      },
      "subjectPrefix": {
        "label": "Prefijo del asunto de respuesta"
      },
      "allowedAttachmentTypes": {
        "label": "Tipos de archivos adjuntos permitidos"
      },
      "maxAttachmentSize": {
        "label": "Tamaño máximo de archivo adjunto"
      },
      "maxAttachmentsPerEmail": {
        "label": "Archivos adjuntos máximos"
      },
      "trustedAuthservIds": {
        "label": "Servicios de autenticación confiables",
        "placeholder": "mx.google.com, separados por comas",
        "help": "Valores authserv-id exactos añadidos por el servicio receptor. Obligatorio al verificar SPF o DKIM."
      }
    }
  }
}
