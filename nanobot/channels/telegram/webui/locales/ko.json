{
  "setup": {
    "docsLabel": "Telegram 설정 가이드 열기",
    "officialLabel": "BotFather 열기",
    "fields": {
      "token": {
        "label": "봇 토큰",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "네트워크 프록시",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "허용된 사용자",
        "placeholder": "* 또는 Telegram 사용자 ID"
      },
      "technical_profileName": {"label": "알림 프로필 이름", "help": "발신 전용 추가 프로필입니다."},
      "technical_mainChatId": {"label": "소유자 사용자 ID", "help": "개인 숫자 ID. 허용 목록에는 이 ID만 포함해야 합니다."},
      "technical_sharedInbox": {"label": "Telegram / WebUI 공유 채팅", "help": "재시작 후 활성화됩니다. 기술 알림 프로필은 필수가 아닙니다."},
      "technical_enabled": {"label": "기술 알림", "help": "선택 사항: 이름과 상태만 전송하며 인수, 결과, 원시 로그는 제외합니다."},
      "technical_chatId": {"label": "기술 채팅 ID", "placeholder": "-1001234567890", "help": "전용 그룹 또는 채널. 수신 메시지는 무시됩니다."},
      "technical_token": {"label": "기술 봇 토큰 (선택 사항)", "help": "비워 두면 기본 봇을 사용합니다. 개인 기술 알림에는 별도 봇이 필요합니다."},
      "technical_includeToolEvents": {"label": "도구 이름과 실행 상태 포함"},
      "technical_includeStatusEvents": {"label": "실행 및 재시도 상태 포함"},
      "groupPolicy": {
        "label": "그룹 동작",
        "choices": {
          "mention": "멘션만",
          "open": "모든 메시지",
          "allowlist": "허용 목록"
        }
      },
      "mode": {
        "label": "연결 모드",
        "choices": {
          "polling": "긴 폴링",
          "webhook": "웹훅"
        }
      },
      "replyToMessage": {
        "label": "메시지에 답장하기",
        "choices": {
          "true": "켜기",
          "false": "끄기"
        }
      },
      "reactEmoji": {
        "label": "이모티콘 읽기"
      },
      "connectionPoolSize": {
        "label": "연결 풀 크기"
      },
      "poolTimeout": {
        "label": "연결 풀 시간 초과"
      },
      "streaming": {
        "label": "스트리밍",
        "choices": {
          "true": "켜기",
          "false": "끄기"
        }
      },
      "inlineKeyboards": {
        "label": "인라인 키보드",
        "choices": {
          "true": "켜기",
          "false": "끄기"
        }
      },
      "richMessages": {
        "label": "리치 메시지",
        "choices": {
          "true": "켜기",
          "false": "끄기"
        }
      },
      "streamEditInterval": {
        "label": "스트림 업데이트 간격"
      },
      "webhookUrl": {
        "label": "웹훅 URL"
      },
      "webhookListenHost": {
        "label": "웹훅 청취 호스트"
      },
      "webhookListenPort": {
        "label": "웹훅 수신 포트"
      },
      "webhookPath": {
        "label": "웹훅 경로"
      },
      "webhookSecretToken": {
        "label": "웹훅 비밀 토큰"
      },
      "webhookMaxConnections": {
        "label": "최대 웹훅 연결"
      }
    }
  }
