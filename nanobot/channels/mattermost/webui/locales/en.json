{
  "setup": {
    "docsLabel": "Open Mattermost setup",
    "officialLabel": "Open Mattermost bot guide",
    "fields": {
      "serverUrl": {
        "label": "Server URL",
        "placeholder": "https://mattermost.example.com"
      },
      "token": {
        "label": "Bot token",
        "placeholder": "Mattermost bot token"
      },
      "teamId": {
        "label": "Team ID",
        "placeholder": "Optional team ID"
      },
      "groupPolicy": {
        "label": "Channel rules",
        "choices": {
          "mention": "Mentions only",
          "open": "All messages",
          "allowlist": "Allowlist"
        }
      },
      "groupPolicyInThread": {
        "label": "Thread rules",
        "choices": {
          "mention": "Mentions only",
          "open": "All messages (no mention needed)",
          "allowlist": "Allowlist"
        }
      },
      "allowFrom": {
        "label": "Allowed users",
        "placeholder": "User IDs, comma separated"
      },
      "allowFromMatchMode": {
        "label": "User matching",
        "choices": {
          "email": "Email",
          "id": "User ID",
          "username": "Username"
        }
      },
      "groupAllowFrom": {
        "label": "Allowed channels"
      },
      "replyInThread": {
        "label": "Thread replies",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "includeThreadContext": {
        "label": "Thread context",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "threadContextLimit": {
        "label": "Context limit"
      },
      "streaming": {
        "label": "Streaming",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "reactEmoji": {
        "label": "Read emoji"
      },
      "doneEmoji": {
        "label": "Done emoji"
      },
      "sendProgress": {
        "label": "Send progress",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "sendToolHints": {
        "label": "Tool hints",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "dm_enabled": {
        "label": "Enable direct messages",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "dm_policy": {
        "label": "Direct message access",
        "choices": {
          "allowlist": "Allowlist",
          "open": "Open"
        }
      },
      "dm_allowFrom": {
        "label": "Allowed DM users"
      }
    }
  }
}
