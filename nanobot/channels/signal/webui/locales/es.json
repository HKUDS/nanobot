{
  "setup": {
    "docsLabel": "Abrir guía de Signal",
    "officialLabel": "Abrir guía de signal-cli",
    "fields": {
      "phoneNumber": {
        "label": "Número de teléfono",
        "placeholder": "+1234567890"
      },
      "daemonHost": {
        "label": "Host del daemon",
        "placeholder": "localhost"
      },
      "daemonPort": {
        "label": "Puerto del daemon",
        "placeholder": "8080"
      },
      "dm_allowFrom": {
        "label": "Remitentes de mensajes directos permitidos",
        "placeholder": "Números o UUID"
      },
      "group_allowFrom": {
        "label": "Grupos permitidos",
        "placeholder": "ID de grupo"
      },
      "groupMessageBufferSize": {
        "label": "Mensajes de contexto grupal"
      },
      "attachmentsDir": {
        "label": "Directorio de archivos adjuntos"
      },
      "dm_enabled": {
        "label": "Habilitar mensajes directos",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "dm_policy": {
        "label": "Acceso a mensajes directos",
        "choices": {
          "allowlist": "Lista de permitidos",
          "open": "Abierto"
        }
      },
      "group_enabled": {
        "label": "Habilitar grupos",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "group_policy": {
        "label": "Acceso grupal",
        "choices": {
          "allowlist": "Lista de permitidos",
          "open": "Abierto"
        }
      },
      "group_requireMention": {
        "label": "Requerir mención en grupos",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      }
    }
  }
