{
  "setup": {
    "docsLabel": "Mattermost 設定ガイドを開く",
    "officialLabel": "Mattermost ボットガイドを開く",
    "fields": {
      "serverUrl": {
        "label": "サーバー URL",
        "placeholder": "https://mattermost.example.com"
      },
      "token": {
        "label": "ボットトークン",
        "placeholder": "Mattermost ボットトークン"
      },
      "teamId": {
        "label": "チーム ID",
        "placeholder": "チーム ID（任意）"
      },
      "groupPolicy": {
        "label": "チャンネルのルール",
        "choices": {
          "mention": "メンションのみ",
          "open": "全メッセージ",
          "allowlist": "許可リスト"
        }
      },
      "groupPolicyInThread": {
        "label": "スレッドのルール",
        "choices": {
          "mention": "メンションのみ",
          "open": "すべてのメッセージ (メンション不要)",
          "allowlist": "許可リスト"
        }
      },
      "allowFrom": {
        "label": "許可ユーザー",
        "placeholder": "ユーザー ID（カンマ区切り）"
      },
      "allowFromMatchMode": {
        "label": "ユーザーの照合",
        "choices": {
          "email": "電子メール",
          "id": "ユーザーID",
          "username": "ユーザー名"
        }
      },
      "groupAllowFrom": {
        "label": "許可チャンネル"
      },
      "replyInThread": {
        "label": "スレッドで返信",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "includeThreadContext": {
        "label": "スレッドの文脈",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "threadContextLimit": {
        "label": "コンテキストの上限"
      },
      "streaming": {
        "label": "ストリーミング",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "reactEmoji": {
        "label": "絵文字を読む"
      },
      "doneEmoji": {
        "label": "完了絵文字"
      },
      "sendProgress": {
        "label": "進捗を送信",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "sendToolHints": {
        "label": "ツールのヒント",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "dm_enabled": {
        "label": "ダイレクトメッセージを有効にする",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "dm_policy": {
        "label": "ダイレクトメッセージへのアクセス",
        "choices": {
          "allowlist": "ホワイトリスト",
          "open": "開く"
        }
      },
      "dm_allowFrom": {
        "label": "許可する DM ユーザー"
      }
    }
  }
}
