  </diagram>
  <diagram id="runtime-internals" name="Runtime Internals">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="inbound" value="InboundMessage&#xa;[Component: bus/events.py]&#xa;channel、sender、chat_id、content、metadata" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="outbound" value="OutboundMessage&#xa;[Component: bus/events.py]&#xa;channel、chat_id、content、media、metadata" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="140" y="370" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="queuein" value="inbound_queue&#xa;[Component: asyncio.Queue]&#xa;输入事件队列" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="140" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="queueout" value="outbound_queue&#xa;[Component: asyncio.Queue]&#xa;输出事件队列" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#63BEF2;strokeColor=#2086C9;" vertex="1" parent="1">
          <mxGeometry x="140" y="560" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="history" value="Session JSONL&#xa;[Container: ~/.nanobot/sessions]&#xa;逐条追加消息，原子写入" style="shape=cylinder3;size=15;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="1">
