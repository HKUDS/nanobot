{
  "setup": {
    "docsLabel": "Abrir guia do Telegram",
    "officialLabel": "Abrir BotFather",
    "fields": {
      "token": {
        "label": "Token do bot",
        "placeholder": "123456:ABC..."
      },
      "proxy": {
        "label": "Proxy de rede",
        "placeholder": "http://127.0.0.1:7890"
      },
      "allowFrom": {
        "label": "Usuários permitidos",
        "placeholder": "* ou IDs de usuário do Telegram"
      },
      "technical_profileName": {"label": "Perfil de notificações", "help": "Perfil adicional somente de saída."},
      "technical_mainChatId": {"label": "ID do proprietário", "help": "ID privado; a lista de permitidos deve conter apenas este ID."},
      "technical_sharedInbox": {"label": "Conversas compartilhadas Telegram / WebUI", "help": "Ativa após reiniciar, sem exigir o perfil técnico."},
      "technical_enabled": {"label": "Notificações técnicas", "help": "Opcional: nomes e estados, sem argumentos, resultados ou logs brutos."},
      "technical_chatId": {"label": "ID da conversa técnica", "placeholder": "-1001234567890", "help": "Grupo ou canal dedicado; mensagens recebidas são ignoradas."},
      "technical_token": {"label": "Token do bot técnico (opcional)", "help": "Vazio usa o bot principal. Mensagens técnicas privadas exigem outro bot."},
      "technical_includeToolEvents": {"label": "Incluir nomes e estados de ferramentas"},
      "technical_includeStatusEvents": {"label": "Incluir estados e novas tentativas"},
      "groupPolicy": {
        "label": "Comportamento em grupos",
        "choices": {
          "mention": "Somente menções",
          "open": "Todas as mensagens",
          "allowlist": "Lista de permissão"
        }
      },
      "mode": {
        "label": "Modo de conexão",
        "choices": {
          "polling": "Votação longa",
          "webhook": "Webhook"
        }
      },
      "replyToMessage": {
        "label": "Responder à mensagem",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "reactEmoji": {
        "label": "Ler emoticons"
      },
      "connectionPoolSize": {
        "label": "Tamanho do pool de conexões"
      },
      "poolTimeout": {
        "label": "Tempo limite do pool de conexões"
      },
      "streaming": {
        "label": "Transmissão",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "inlineKeyboards": {
        "label": "Teclados embutidos",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "richMessages": {
        "label": "Mensagens ricas",
        "choices": {
          "true": "Ligado",
          "false": "Desligado"
        }
      },
      "streamEditInterval": {
        "label": "Intervalo de atualização de fluxo"
      },
      "webhookUrl": {
        "label": "URL do webhook"
      },
      "webhookListenHost": {
        "label": "Host de escuta do webhook"
      },
      "webhookListenPort": {
        "label": "Porta de escuta do webhook"
      },
      "webhookPath": {
        "label": "Caminho do webhook"
      },
      "webhookSecretToken": {
        "label": "Token secreto do webhook"
      },
      "webhookMaxConnections": {
        "label": "Máximo de conexões de webhook"
      }
    }
  }
}
