{
  "setup": {
    "docsLabel": "Open Email setup",
    "officialLabel": "Open app password guide",
    "presetLabel": "Quick fill",
    "sections": {
      "receiving": "Receiving mail",
      "sending": "Sending mail"
    },
    "presets": {
      "gmail": "Gmail",
      "outlook": "Outlook",
      "icloud": "iCloud"
    },
    "fields": {
      "consentGranted": {
        "label": "Email access",
        "choices": {
          "true": "Granted",
          "false": "Not granted"
        }
      },
      "imapHost": {
        "label": "IMAP host",
        "placeholder": "imap.gmail.com"
      },
      "imapUsername": {
        "label": "IMAP username",
        "placeholder": "bot@example.com"
      },
      "imapPassword": {
        "label": "IMAP password",
        "placeholder": "App password"
      },
      "smtpHost": {
        "label": "SMTP host",
        "placeholder": "smtp.gmail.com"
      },
      "smtpUsername": {
        "label": "SMTP username",
        "placeholder": "bot@example.com"
      },
      "smtpPassword": {
        "label": "SMTP password",
        "placeholder": "App password"
      },
      "imapPort": {
        "label": "IMAP port",
        "placeholder": "993"
      },
      "smtpPort": {
        "label": "SMTP port",
        "placeholder": "587"
      },
      "fromAddress": {
        "label": "From address",
        "placeholder": "bot@example.com"
      },
      "oauthTenantId": {
        "label": "Microsoft tenant ID",
        "placeholder": "00000000-0000-0000-0000-000000000000",
        "help": "Office365/Outlook only. Alternative to IMAP/SMTP passwords — leave blank to use passwords instead. Run `nanobot channels login email` after saving these three fields."
      },
      "oauthClientId": {
        "label": "Microsoft app (client) ID",
        "placeholder": "00000000-0000-0000-0000-000000000000"
      },
      "oauthClientSecret": {
        "label": "Microsoft client secret",
        "placeholder": "App registration secret value"
      },
      "pollIntervalSeconds": {
        "label": "Check interval (seconds)",
        "placeholder": "30"
      },
      "allowFrom": {
        "label": "Allowed senders",
        "placeholder": "Email addresses, comma separated"
      },
      "verifyDkim": {
        "label": "Verify DKIM",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "verifySpf": {
        "label": "Verify SPF",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "imapMailbox": {
        "label": "IMAP mailbox"
      },
      "imapUseSsl": {
        "label": "IMAP SSL",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "smtpUseTls": {
        "label": "SMTP TLS",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "smtpUseSsl": {
        "label": "SMTP SSL",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "autoReplyEnabled": {
        "label": "Automatic replies",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "markSeen": {
        "label": "Mark as read",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "postAction": {
        "label": "After processing",
        "choices": {
          "delete": "Delete",
          "move": "Move"
        }
      },
      "postActionMoveMailbox": {
        "label": "Target mailbox"
      },
      "postActionExpunge": {
        "label": "Permanent deletion",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "postActionIgnoreSkipped": {
        "label": "Keep skipped mail",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "maxBodyChars": {
        "label": "Body length limit (characters)"
      },
      "subjectPrefix": {
        "label": "Subject prefix"
      },
      "allowedAttachmentTypes": {
        "label": "Attachment types"
      },
      "maxAttachmentSize": {
        "label": "Attachment limit (bytes)"
      },
      "maxAttachmentsPerEmail": {
        "label": "Attachment count limit"
      },
      "trustedAuthservIds": {
        "label": "Trusted authentication services",
        "placeholder": "mx.google.com, comma separated",
        "help": "Enter trusted authserv-id values.\n\nExact authserv-id values added by the receiving mail service. Required when SPF or DKIM verification is on."
      }
    }
  }
}
