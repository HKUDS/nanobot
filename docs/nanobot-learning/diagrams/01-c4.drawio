          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="250"/><mxPoint x="530" y="250"/><mxPoint x="530" y="250"/><mxPoint x="530" y="250"/><mxPoint x="530" y="430"/><mxPoint x="530" y="430"/><mxPoint x="530" y="430"/><mxPoint x="530" y="430"/></Array></mxGeometry>
