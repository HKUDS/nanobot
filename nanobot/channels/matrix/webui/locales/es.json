{
  "setup": {
    "docsLabel": "Abrir guía de Matrix",
    "officialLabel": "Abrir lista de clientes Matrix",
    "fields": {
      "homeserver": {
        "label": "Homeserver",
        "placeholder": "https://matrix.org"
      },
      "userId": {
        "label": "ID de usuario",
        "placeholder": "@nanobot:matrix.org"
      },
      "password": {
        "label": "Contraseña",
        "placeholder": "••••••"
      },
      "accessToken": {
        "label": "Token de acceso",
        "placeholder": "Introduce un token de acceso"
      },
      "deviceId": {
        "label": "ID del dispositivo",
        "placeholder": "Obligatorio con token"
      },
      "groupPolicy": {
        "label": "Reglas de grupo",
        "choices": {
          "mention": "Solo menciones",
          "open": "Todos los mensajes",
          "allowlist": "Lista de permitidos",
          "listen": "Escuchar (responder al mencionar)"
        }
      },
      "groupPolicyOverrides": {
        "label": "Excepciones de reglas por sala (JSON)"
      },
      "allowFrom": {
        "label": "Usuarios permitidos"
      },
      "e2eeEnabled": {
        "label": "Cifrado de extremo a extremo",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "sasVerification": {
        "label": "verificación SAS",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "syncStopGraceSeconds": {
        "label": "Espera al detener sync (segundos)"
      },
      "maxMediaBytes": {
        "label": "Límite multimedia (bytes)"
      },
      "maxConcurrentMediaDownloads": {
        "label": "Descargas simultáneas"
      },
      "groupAllowFrom": {
        "label": "Grupos permitidos"
      },
      "allowRoomMentions": {
        "label": "Menciones de sala",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "replyToMessage": {
        "label": "Citar al responder",
        "choices": {
          "true": "Encendido",
          "false": "Apagado"
        }
      },
      "streaming": {
        "label": "Transmisión",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "useProxy": {
        "label": "Usar proxy"
      }
    }
  }
}
